      "path": "invite/abc123",
      "referrer_as_play_returns_it": "utm_content=invite%2Fabc123",
      "play_url_referrer_param": "utm_content%3Dinvite%252Fabc123",
      "play_store_url": "https://play.google.com/store/apps/details?id=com.example.app&referrer=utm_content%3Dinvite%252Fabc123",
      "decoding": "form",
      "value": "invite/abc123",
      "expected_deep_link": null,
      "rejection": "notAPath"
    },
