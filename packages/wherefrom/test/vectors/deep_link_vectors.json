      "play_store_url": "https://play.google.com/store/apps/details?id=com.example.app&referrer=utm_content%3D%252Finvites",
      "decoding": "form",
      "value": "/invites",
      "expected_deep_link": null,
      "rejection": "notAllowlisted"
    },
    {
