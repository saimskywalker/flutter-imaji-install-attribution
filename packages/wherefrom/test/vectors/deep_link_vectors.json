      "referrer_as_play_returns_it": "utm_content=https%3A%2F%2Fexample.com%3A8443%2Fitems%2F1",
      "play_url_referrer_param": "utm_content%3Dhttps%253A%252F%252Fexample.com%253A8443%252Fitems%252F1",
